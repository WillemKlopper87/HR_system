# Copy to .env for docker-compose. Never commit .env.
# DJANGO_SECRET_KEY/ASSESSMENT_WEBHOOK_SECRET below are placeholders on
# purpose: with DJANGO_DEBUG=0, config/settings.py now refuses to start at
# all if either is left at a development default or under 32 characters
# (2026-08-28 fix) -- generate real values, e.g.
# `python -c "import secrets; print(secrets.token_urlsafe(48))"`, before
# this file becomes a working .env.
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=0
ASSESSMENT_WEBHOOK_SECRET=change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Set to 0 when running the compose stack over plain http on a LAN (no TLS at
# the edge yet); leave at 1 behind a TLS-terminating proxy.
DJANGO_SECURE_SSL_REDIRECT=0
# Both off by default -- these are real domain-topology decisions (does
# EVERY subdomain of the production domain serve exclusively over TLS?
# do you want this domain hardcoded into browsers' HSTS preload list,
# effectively one-way?), not something to enable without having actually
# made that call. Set both to 1 only once you have.
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=0
DJANGO_SECURE_HSTS_PRELOAD=0
# Origins the browser is allowed to POST/PUT/PATCH/DELETE from (CSRF). Only
# needed when frontend and backend are on different origins, e.g. the Vite
# dev server (localhost:5173) proxying to this app — same-origin prod
# deployments behind one reverse proxy (ADR-005) don't need this changed.
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

POSTGRES_DB=hcm
POSTGRES_USER=hcm
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432

REDIS_URL=redis://redis:6379/0

# Optional Prometheus scrape credential. /metrics remains indistinguishable
# from a missing route unless this is set to at least 32 characters. Use a
# dedicated machine secret, not a Django/user credential.
# METRICS_BEARER_TOKEN=

# Rate limits (rbac_audit/throttling.py) — override per environment if needed
# THROTTLE_LOGIN_BURST=30/min
# THROTTLE_LOGIN_SUSTAINED=500/hour
# THROTTLE_LOGIN_USERNAME=10/min
# THROTTLE_TOTP_BURST=5/min
# THROTTLE_TOTP_SUSTAINED=30/hour

# Collab platform push (ADR-011, integrations/collab.py). Create the service
# account + key on the collab side (its `create_service_account` script).
COLLAB_ENABLED=0
COLLAB_BASE_URL=http://localhost:8020
COLLAB_API_KEY=
HCM_PUBLIC_URL=http://localhost:5173
